# Core
PROJECT_NAME="UBCEX Enterprise API"
ENVIRONMENT="development"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://yourproductiondomain.com"

# MongoDB Atlas
# Replace with your actual MongoDB Atlas connection string. DO NOT commit the real .env file.
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="ubcex_prod_db"

# Security
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="replace-this-with-a-very-secure-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third Party Integrations (Future)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
